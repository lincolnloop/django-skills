{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MaintenanceWindow": {
      "type": "object",
      "properties": {
        "id":              { "type": ["integer", "string"] },
        "name":            { "type": ["string", "null"] },
        "state":           { "type": ["string", "null"], "enum": ["active", "paused", "pending", null] },
        "start_at":        { "type": ["string", "null"], "description": "RFC3339 datetime" },
        "end_at":          { "type": ["string", "null"], "description": "RFC3339 datetime" },
        "timezone":        { "type": ["string", "null"], "description": "IANA timezone name" },
        "repeat_interval": { "type": ["string", "null"], "enum": ["never", "1d", "1w", "2w", "1m", null] },
        "tags":            { "type": "array", "items": { "type": "string" } },
        "tests":           { "type": "array", "items": { "type": ["integer", "string"] }, "description": "Check IDs covered by this window" }
      },
      "required": ["id"],
      "additionalProperties": true
    }
  },
  "title": "StatusCakeMaintenanceWindows",
  "description": "All maintenance windows. Output of scripts/list-maintenance-windows.py. Sorted ascending by start_at.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "maintenance_windows" },
    "generated_at": { "type": "string" },
    "filters": {
      "type": "object",
      "properties": {
        "state": { "type": ["string", "null"], "enum": ["active", "paused", "pending", null] }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" }
      },
      "required": ["total"],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/MaintenanceWindow" }
    }
  },
  "required": ["category", "generated_at", "filters", "counts", "items"],
  "additionalProperties": false
}
