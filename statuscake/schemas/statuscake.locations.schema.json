{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ProbeLocation": {
      "type": "object",
      "properties": {
        "description":  { "type": ["string", "null"] },
        "ipv4":         { "type": ["string", "null"] },
        "ipv6":         { "type": ["string", "null"] },
        "region":       { "type": ["string", "null"] },
        "region_code":  { "type": ["string", "null"], "description": "ISO region code e.g. UK, US" },
        "status":       { "type": ["string", "null"] }
      },
      "required": [],
      "additionalProperties": true
    }
  },
  "title": "StatusCakeLocations",
  "description": "Probe server locations for uptime and pagespeed checks. Output of scripts/list-locations.py.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "locations" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "uptime_locations":    { "type": "integer" },
        "pagespeed_locations": { "type": "integer" }
      },
      "required": ["uptime_locations", "pagespeed_locations"],
      "additionalProperties": false
    },
    "uptime_locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/ProbeLocation" },
      "description": "Sorted alphabetically by region"
    },
    "pagespeed_locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/ProbeLocation" },
      "description": "Sorted alphabetically by region"
    }
  },
  "required": ["category", "generated_at", "counts", "uptime_locations", "pagespeed_locations"],
  "additionalProperties": false
}
