{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DateRange": {
      "type": "object",
      "properties": {
        "start_date": { "type": "string" },
        "end_date":   { "type": "string" }
      },
      "required": ["start_date", "end_date"],
      "additionalProperties": false
    },
    "ExpenseClient": {
      "type": "object",
      "properties": {
        "client_id":       { "type": "integer" },
        "client_name":     { "type": "string" },
        "total_amount":    { "type": ["number", "null"] },
        "billable_amount": { "type": ["number", "null"] },
        "currency":        { "type": ["string", "null"] }
      },
      "required": ["client_id", "client_name"],
      "additionalProperties": true
    },
    "ExpenseProject": {
      "type": "object",
      "properties": {
        "project_id":      { "type": "integer" },
        "project_name":    { "type": "string" },
        "client_id":       { "type": ["integer", "null"] },
        "client_name":     { "type": ["string", "null"] },
        "total_amount":    { "type": ["number", "null"] },
        "billable_amount": { "type": ["number", "null"] },
        "currency":        { "type": ["string", "null"] }
      },
      "required": ["project_id", "project_name"],
      "additionalProperties": true
    },
    "ExpenseCategory": {
      "type": "object",
      "properties": {
        "expense_category_id":   { "type": "integer" },
        "expense_category_name": { "type": "string" },
        "total_amount":          { "type": ["number", "null"] },
        "billable_amount":       { "type": ["number", "null"] },
        "currency":              { "type": ["string", "null"] }
      },
      "required": ["expense_category_id", "expense_category_name"],
      "additionalProperties": true
    },
    "ExpenseTeamMember": {
      "type": "object",
      "properties": {
        "user_id":         { "type": "integer" },
        "user_name":       { "type": "string" },
        "is_contractor":   { "type": ["boolean", "null"] },
        "total_amount":    { "type": ["number", "null"] },
        "billable_amount": { "type": ["number", "null"] },
        "currency":        { "type": ["string", "null"] }
      },
      "required": ["user_id", "user_name"],
      "additionalProperties": true
    }
  },
  "title": "HarvestReportExpenses",
  "description": "Expense totals broken down by one of four dimensions. Output of scripts/report-expenses.py. The category and top-level data key reflect the chosen --breakdown dimension.",
  "oneOf": [
    {
      "description": "Expenses broken down by client (--breakdown clients)",
      "type": "object",
      "properties": {
        "category":     { "type": "string", "const": "expenses_clients" },
        "since":        { "type": "string" },
        "until":        { "type": "string" },
        "range":        { "$ref": "#/$defs/DateRange" },
        "generated_at": { "type": "string" },
        "counts": {
          "type": "object",
          "properties": {
            "active_clients":  { "type": "integer" },
            "total_amount":    { "type": "number" },
            "billable_amount": { "type": "number" }
          },
          "required": ["active_clients", "total_amount", "billable_amount"]
        },
        "clients": { "type": "array", "items": { "$ref": "#/$defs/ExpenseClient" } }
      },
      "required": ["category", "range", "generated_at", "counts", "clients"]
    },
    {
      "description": "Expenses broken down by project (--breakdown projects)",
      "type": "object",
      "properties": {
        "category":     { "type": "string", "const": "expenses_projects" },
        "since":        { "type": "string" },
        "until":        { "type": "string" },
        "range":        { "$ref": "#/$defs/DateRange" },
        "generated_at": { "type": "string" },
        "counts": {
          "type": "object",
          "properties": {
            "active_projects": { "type": "integer" },
            "total_amount":    { "type": "number" },
            "billable_amount": { "type": "number" }
          },
          "required": ["active_projects", "total_amount", "billable_amount"]
        },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/ExpenseProject" } }
      },
      "required": ["category", "range", "generated_at", "counts", "projects"]
    },
    {
      "description": "Expenses broken down by category (--breakdown categories)",
      "type": "object",
      "properties": {
        "category":     { "type": "string", "const": "expenses_categories" },
        "since":        { "type": "string" },
        "until":        { "type": "string" },
        "range":        { "$ref": "#/$defs/DateRange" },
        "generated_at": { "type": "string" },
        "counts": {
          "type": "object",
          "properties": {
            "active_categories": { "type": "integer" },
            "total_amount":      { "type": "number" },
            "billable_amount":   { "type": "number" }
          },
          "required": ["active_categories", "total_amount", "billable_amount"]
        },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/ExpenseCategory" } }
      },
      "required": ["category", "range", "generated_at", "counts", "categories"]
    },
    {
      "description": "Expenses broken down by team member (--breakdown team)",
      "type": "object",
      "properties": {
        "category":     { "type": "string", "const": "expenses_team" },
        "since":        { "type": "string" },
        "until":        { "type": "string" },
        "range":        { "$ref": "#/$defs/DateRange" },
        "generated_at": { "type": "string" },
        "counts": {
          "type": "object",
          "properties": {
            "active_team":     { "type": "integer" },
            "total_amount":    { "type": "number" },
            "billable_amount": { "type": "number" }
          },
          "required": ["active_team", "total_amount", "billable_amount"]
        },
        "team": { "type": "array", "items": { "$ref": "#/$defs/ExpenseTeamMember" } }
      },
      "required": ["category", "range", "generated_at", "counts", "team"]
    }
  ]
}
