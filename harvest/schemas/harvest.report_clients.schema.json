{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DateRange": {
      "type": "object",
      "properties": {
        "start_date": { "type": "string" },
        "end_date":   { "type": "string" }
      },
      "required": ["start_date", "end_date"],
      "additionalProperties": false
    },
    "ClientResult": {
      "type": "object",
      "properties": {
        "client_id":      { "type": "integer" },
        "client_name":    { "type": "string" },
        "total_hours":    { "type": ["number", "null"] },
        "billable_hours": { "type": ["number", "null"] },
        "billable_amount":{ "type": ["number", "null"] },
        "currency":       { "type": ["string", "null"] }
      },
      "required": ["client_id", "client_name"],
      "additionalProperties": true
    }
  },
  "title": "HarvestReportClients",
  "description": "Hours and billable amounts per client for a date range. Output of scripts/report-clients.py.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "clients" },
    "since":        { "type": "string" },
    "until":        { "type": "string" },
    "range":        { "$ref": "#/$defs/DateRange" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "active_clients": { "type": "integer" },
        "total_hours":    { "type": "number" },
        "billable_hours": { "type": "number" }
      },
      "required": ["active_clients", "total_hours", "billable_hours"],
      "additionalProperties": false
    },
    "clients": {
      "type": "array",
      "items": { "$ref": "#/$defs/ClientResult" },
      "description": "One entry per client with logged time, sorted descending by total_hours"
    }
  },
  "required": ["category", "range", "generated_at", "counts", "clients"],
  "additionalProperties": false
}
