{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DateRange": {
      "type": "object",
      "properties": {
        "start_date": { "type": "string" },
        "end_date":   { "type": "string" }
      },
      "required": ["start_date", "end_date"],
      "additionalProperties": false
    },
    "ProjectResult": {
      "type": "object",
      "properties": {
        "project_id":     { "type": "integer" },
        "project_name":   { "type": "string" },
        "client_id":      { "type": ["integer", "null"] },
        "client_name":    { "type": ["string", "null"] },
        "total_hours":    { "type": ["number", "null"] },
        "billable_hours": { "type": ["number", "null"] },
        "billable_amount":{ "type": ["number", "null"] },
        "currency":       { "type": ["string", "null"] }
      },
      "required": ["project_id", "project_name"],
      "additionalProperties": true
    }
  },
  "title": "HarvestReportProjects",
  "description": "Hours and billable amounts per project for a date range. Output of scripts/report-projects.py. Requires Manager or Administrator access.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "projects" },
    "since":        { "type": "string" },
    "until":        { "type": "string" },
    "range":        { "$ref": "#/$defs/DateRange" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "active_projects": { "type": "integer" },
        "total_hours":     { "type": "number" },
        "billable_hours":  { "type": "number" }
      },
      "required": ["active_projects", "total_hours", "billable_hours"],
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/ProjectResult" },
      "description": "One entry per project with logged time, sorted descending by total_hours"
    }
  },
  "required": ["category", "range", "generated_at", "counts", "projects"],
  "additionalProperties": false
}
