{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DateRange": {
      "type": "object",
      "properties": {
        "start_date": { "type": "string" },
        "end_date":   { "type": "string" }
      },
      "required": ["start_date", "end_date"],
      "additionalProperties": false
    },
    "UninvoicedProject": {
      "type": "object",
      "description": "Billable work logged against a project that has not yet been invoiced.",
      "properties": {
        "client_id":           { "type": ["integer", "null"] },
        "client_name":         { "type": ["string", "null"] },
        "project_id":          { "type": "integer" },
        "project_name":        { "type": "string" },
        "currency":            { "type": ["string", "null"] },
        "total_hours":         { "type": ["number", "null"], "description": "All hours logged in the period" },
        "uninvoiced_hours":    { "type": ["number", "null"], "description": "Billable hours not yet invoiced" },
        "uninvoiced_expenses": { "type": ["number", "null"], "description": "Billable expense amount not yet invoiced" },
        "uninvoiced_amount":   { "type": ["number", "null"], "description": "Total uninvoiced value (hours + expenses)" }
      },
      "required": ["project_id", "project_name"],
      "additionalProperties": true
    }
  },
  "title": "HarvestReportUninvoiced",
  "description": "Billable hours and expenses not yet invoiced, broken down by project. Output of scripts/report-uninvoiced.py.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "uninvoiced" },
    "since":        { "type": "string" },
    "until":        { "type": "string" },
    "range":        { "$ref": "#/$defs/DateRange" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "total_projects":          { "type": "integer" },
        "total_uninvoiced_hours":  { "type": "number" },
        "total_uninvoiced_amount": { "type": "number" }
      },
      "required": ["total_projects", "total_uninvoiced_hours", "total_uninvoiced_amount"],
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/UninvoicedProject" },
      "description": "Sorted descending by uninvoiced_amount"
    }
  },
  "required": ["category", "range", "generated_at", "counts", "projects"],
  "additionalProperties": false
}
