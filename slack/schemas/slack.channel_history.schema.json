{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Reaction": {
      "type": "object",
      "properties": {
        "name":  { "type": "string" },
        "count": { "type": "integer" }
      },
      "required": ["name", "count"],
      "additionalProperties": false
    },
    "Reply": {
      "type": "object",
      "properties": {
        "ts":   { "type": ["string", "null"] },
        "user": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] }
      },
      "required": [],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "ts":          { "type": ["string", "null"], "description": "Message timestamp (used as unique ID)" },
        "user":        { "type": ["string", "null"], "description": "Slack user ID of the author" },
        "text":        { "type": ["string", "null"] },
        "reply_count": { "type": "integer" },
        "reactions":   { "type": "array", "items": { "$ref": "#/$defs/Reaction" } },
        "replies":     { "type": "array", "items": { "$ref": "#/$defs/Reply" }, "description": "Present only when --include-replies is used" }
      },
      "required": ["ts"],
      "additionalProperties": false
    }
  },
  "title": "SlackChannelHistory",
  "description": "Recent messages from a channel. Output of scripts/read-channel.py. Newest first.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "channel_history" },
    "channel":      { "type": "string", "description": "Channel ID" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": { "total": { "type": "integer" } },
      "required": ["total"],
      "additionalProperties": false
    },
    "messages": {
      "type": "array",
      "items": { "$ref": "#/$defs/Message" }
    }
  },
  "required": ["category", "channel", "generated_at", "counts", "messages"],
  "additionalProperties": false
}
