{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Channel": {
      "type": "object",
      "properties": {
        "id":          { "type": ["string", "null"] },
        "name":        { "type": ["string", "null"] },
        "is_private":  { "type": ["boolean", "null"] },
        "is_archived": { "type": ["boolean", "null"] },
        "num_members": { "type": ["integer", "null"] },
        "topic":       { "type": ["string", "null"] },
        "purpose":     { "type": ["string", "null"] }
      },
      "required": ["id"],
      "additionalProperties": false
    }
  },
  "title": "SlackChannels",
  "description": "Workspace channels. Output of scripts/list-channels.py. Sorted alphabetically by name.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "channels" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": { "total": { "type": "integer" } },
      "required": ["total"],
      "additionalProperties": false
    },
    "channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/Channel" }
    }
  },
  "required": ["category", "generated_at", "counts", "channels"],
  "additionalProperties": false
}
