{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Offering": {
      "type": "object",
      "properties": {
        "project_offering_name": { "type": "string" },
        "financial_model":       { "type": ["string", "null"] },
        "crm_id":                { "type": ["string", "null"] },
        "timesheet_id":          { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "Project": {
      "type": "object",
      "properties": {
        "id":                   { "type": "string" },
        "name":                 { "type": ["string", "null"] },
        "client_name":          { "type": ["string", "null"] },
        "start_date":           { "type": ["string", "null"] },
        "end_date":             { "type": ["string", "null"] },
        "project_status":       { "type": ["string", "null"],
                                  "enum": ["PreSale", "AwaitingStart", "InProgress", "Completed", "OnHold", null] },
        "project_risk":         { "type": ["string", "null"] },
        "stage_name":           { "type": ["string", "null"] },
        "tags":                 { "type": "array", "items": { "type": "string" } },
        "target_budget":        { "type": ["number", "null"] },
        "target_margin":        { "type": ["number", "null"] },
        "crm_id":               { "type": ["string", "null"] },
        "custom_external_ids":  { "type": ["object", "array", "null"] },
        "project_owner":        { "type": ["string", "null"] },
        "sales_owner":          { "type": ["string", "null"] },
        "offerings":            { "type": "object", "additionalProperties": { "$ref": "#/$defs/Offering" } }
      },
      "required": ["id"],
      "additionalProperties": true
    }
  },
  "title": "ParallaxProjects",
  "description": "Project listing from /api/projects with totalled financial data. Does not accept date parameters — returns all-time totals.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "projects" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" }
      },
      "required": ["total"],
      "additionalProperties": true
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/Project" } }
  },
  "required": ["category", "generated_at", "counts", "items"],
  "additionalProperties": true
}
