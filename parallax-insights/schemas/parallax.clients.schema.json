{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Client": {
      "type": "object",
      "properties": {
        "name":           { "type": "string" },
        "projects_count": { "type": "integer" }
      },
      "required": ["name", "projects_count"],
      "additionalProperties": true
    }
  },
  "title": "ParallaxClients",
  "description": "Unique client names derived from /api/projects. There is no dedicated clients endpoint in the Insights API.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "clients" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" }
      },
      "required": ["total"],
      "additionalProperties": true
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/Client" } }
  },
  "required": ["category", "generated_at", "counts", "items"],
  "additionalProperties": true
}
