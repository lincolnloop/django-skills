{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Person": {
      "type": "object",
      "properties": {
        "id":                  { "type": "string" },
        "name":                { "type": "string" },
        "first_name":          { "type": ["string", "null"] },
        "last_name":           { "type": ["string", "null"] },
        "email":               { "type": ["string", "null"] },
        "worker_type":         { "type": ["string", "null"],
                                 "enum": ["FullTime", "Contractor", "Placeholder", null] },
        "primary_dept":        { "type": ["string", "null"] },
        "primary_role":        { "type": ["string", "null"] },
        "cost_rate":           { "type": ["number", "null"] },
        "location":            { "type": ["string", "null"] },
        "billable_capacity":   { "type": ["number", "null"] },
        "target_utilization":  { "type": ["number", "null"] },
        "tags":                { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name"],
      "additionalProperties": true
    }
  },
  "title": "ParallaxPeople",
  "description": "Team member roster from /api/people/utilization.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "people" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" }
      },
      "required": ["total"],
      "additionalProperties": true
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/Person" } }
  },
  "required": ["category", "generated_at", "counts", "items"],
  "additionalProperties": true
}
