{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DateRange": {
      "type": "object",
      "properties": {
        "start_date": { "type": "string" },
        "end_date":   { "type": "string" }
      },
      "required": ["start_date", "end_date"],
      "additionalProperties": true
    },
    "PersonHours": {
      "type": "object",
      "properties": {
        "person_id":      { "type": "string" },
        "name":           { "type": "string" },
        "total_hours":    { "type": "number" },
        "billable_hours": { "type": "number" },
        "entries":        { "type": "integer" }
      },
      "required": ["person_id", "total_hours", "billable_hours", "entries"],
      "additionalProperties": true
    },
    "TimeEntry": {
      "type": "object",
      "properties": {
        "person_id":     { "type": "string" },
        "person_name":   { "type": "string" },
        "recorded_date": { "type": "string" },
        "hours":         { "type": "number" },
        "billable":      { "type": "boolean" }
      },
      "required": ["person_id", "recorded_date", "hours", "billable"],
      "additionalProperties": true
    }
  },
  "title": "ParallaxTimeEntries",
  "description": "Actual hours per person per period from /api/people/utilization. Project-level breakdown is not available via the Insights API.",
  "type": "object",
  "properties": {
    "category":     { "type": "string", "const": "time_entries" },
    "since":        { "type": "string" },
    "until":        { "type": "string" },
    "range":        { "$ref": "#/$defs/DateRange" },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "total_entries":      { "type": "integer" },
        "total_hours":        { "type": "number" },
        "billable_hours":     { "type": "number" },
        "non_billable_hours": { "type": "number" },
        "active_people":      { "type": "integer" }
      },
      "required": ["total_entries", "total_hours", "billable_hours", "non_billable_hours", "active_people"],
      "additionalProperties": true
    },
    "by_person": { "type": "array", "items": { "$ref": "#/$defs/PersonHours" } },
    "by_project": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "description": "Always empty — project-level breakdown not available in Insights API"
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/TimeEntry" } }
  },
  "required": ["category", "range", "generated_at", "counts", "by_person", "items"],
  "additionalProperties": true
}
